# ============================================================
# Nanobot 环境变量配置
# ============================================================
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
#
# 本文件由 start_local.py（本地开发）和 docker-compose.yml（Docker 部署）共同读取。
# start_local.py 会自动将 *_API_KEY / *_API_BASE 变量注入 PLATFORM_ 前缀传给 Gateway。
# ============================================================


# ── LLM 服务商 API Key ──────────────────────────────────────
# 至少配置一个 API Key，否则无法调用大模型。
# 只需填写你实际使用的服务商，其余留空即可。
#
# 模型命名规则（DEFAULT_MODEL 和前端选择模型时通用）：
#   前缀/模型名  — 显式指定供应商，如 "dashscope/qwen-turbo"
#   纯模型名     — 按关键词自动匹配，如 "claude-sonnet-4-5" 自动走 Anthropic
#
# ┌─────────────┬───────────────────────────────────────────────┐
# │ 前缀        │ 示例                                          │
# ├─────────────┼───────────────────────────────────────────────┤
# │ claude/     │ claude/claude-sonnet-4-5                      │
# │ openai/     │ openai/gpt-5.2               │
# │ deepseek/   │ deepseek/deepseek-chat, deepseek/deepseek-reasoner │
# │ dashscope/  │ dashscope/qwen3-coder-plus, dashscope/qwen-turbo   │
# │ kimi/       │ kimi/kimi-k2.5, kimi/moonshot-v1-128k        │
# │ zhipu/      │ zhipu/glm-4-flash, zhipu/glm-4              │
# │ doubao/     │ doubao/doubao-pro-256k                       │
# │ aihubmix/   │ aihubmix/claude-sonnet-4-5                   │
# │ vllm/       │ vllm/Qwen2.5-7B-Instruct                    │
# │ (无前缀)    │ claude-sonnet-4-5 → 自动匹配 Anthropic       │
# │ (无前缀)    │ gpt-4o → 自动匹配 OpenAI                     │
# └─────────────┴───────────────────────────────────────────────┘
# 使用阿里云上的Minimax模型，或者kimi模型： dashscope/Kimi/kimi-k2.5
# DEFAULT_MODEL=dashscope/MiniMax/MiniMax-M2.7
# DEFAULT_MODEL=dashscope/Kimi/kimi-k2.5


# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=nanobot
POSTGRES_PASSWORD=nanobot
POSTGRES_DB=nanobot_platform

# Anthropic (Claude 系列)
# 关键词匹配: 模型名含 "claude" 自动路由
# 示例: claude-sonnet-4-5, claude/claude-opus-4-5
ANTHROPIC_API_KEY=

# OpenAI (GPT / o 系列)
# 关键词匹配: 模型名含 "gpt"、"o1"、"o3"、"o4" 自动路由
# 示例: gpt-4o, openai/gpt-4o-mini, openai/o3-mini
OPENAI_API_KEY=
# 如果设置兼容OPENAI的模型，自制URL，可以这样
# OPENAI_API_BASE=

# DeepSeek
# 关键词匹配: 模型名含 "deepseek" 自动路由
# 示例: deepseek/deepseek-chat, deepseek/deepseek-reasoner
DEEPSEEK_API_KEY=

# 阿里云 DashScope (通义千问 Qwen 系列)
# 关键词匹配: 模型名含 "qwen" 自动路由
# 示例支持模型: dashscope/qwen3-coder-plus, dashscope/qwen-turbo, qwen-max
DASHSCOPE_API_KEY=

# Moonshot / Kimi
# 关键词匹配: 模型名含 "kimi" 或 "moonshot" 自动路由
# 示例: kimi/kimi-k2.5, kimi/moonshot-v1-128k
# 注意: kimi-k2.5 等模型不支持自定义 temperature，系统会自动跳过该参数
KIMI_API_KEY=

# 智谱 AI (GLM 系列)
# 关键词匹配: 模型名含 "glm" 自动路由
# 示例: zhipu/glm-4-flash, zhipu/glm-4, glm-4-flash
# DEFAULT_MODEL=zhipu/GLM-4.7
ZHIPU_API_KEY=xxxxx

# 豆包 (字节跳动 / 火山引擎)
# 关键词匹配: 模型名含 "doubao" 自动路由
# 示例: doubao/doubao-pro-256k, doubao/doubao-lite-128k
# API Base: https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=

# AiHubMix (聚合代理，可访问多家模型)
# 关键词匹配: 模型名含 "aihubmix" 自动路由
# 示例: aihubmix/claude-sonnet-4-5, aihubmix/gpt-4o
AIHUBMIX_API_KEY=

# OpenRouter (聚合代理，作为最后兜底)
# 当模型名匹配不到上述任何 provider 时，自动走 OpenRouter
# 示例: openrouter/anthropic/claude-sonnet-4-5
OPENROUTER_API_KEY=


# ── 自部署 / 本地模型 (vLLM) ─────────────────────────────────
# 如果你用 vLLM 部署了本地模型，配置以下两项。
# API Key 可以填任意非空字符串（vLLM 默认不校验 key）。
#
# 路由规则:
#   1. 使用 "vllm/" 前缀显式指定 → vllm/Qwen2.5-7B-Instruct
#   2. 模型名匹配不到任何云端 provider 时，自动作为兜底
#
# 启动 vLLM 示例：
#   vllm serve /data/models/Qwen2.5-7B-Instruct \
#     --served-model-name Qwen2.5-7B-Instruct \
#     --enable-auto-tool-choice --tool-call-parser hermes \
#     --port 8000
HOSTED_VLLM_API_KEY=
HOSTED_VLLM_API_BASE=
# 示例：
# HOSTED_VLLM_API_KEY=dummy
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1


# ── 默认模型 ─────────────────────────────────────────────────
# 新用户容器的默认模型。推荐使用 "前缀/模型名" 格式明确指定 provider。
# 示例：
#   DEFAULT_MODEL=dashscope/qwen3-coder-plus    # 阿里云 Qwen
#   DEFAULT_MODEL=claude-sonnet-4-5              # Anthropic Claude
#   DEFAULT_MODEL=kimi/kimi-k2.5                 # Moonshot Kimi
#   DEFAULT_MODEL=vllm/Qwen2.5-7B-Instruct      # 本地 vLLM
#   DEFAULT_MODEL=openai/gpt-5.2                  # OpenAI
#   DEFAULT_MODEL=deepseek/deepseek-chat         # DeepSeek
DEFAULT_MODEL=dashscope/qwen3-coder-plus

# 网关强制路由模型（可选）。
# 留空时尊重用户容器请求的模型；设置后，所有 LLM 请求都会在 gateway 侧改路由到该模型。
# 适合无须重建用户容器就全局切换真实使用模型。
# 示例：
#   ROUTE_MODEL=openai/gpt-5.1
#   ROUTE_MODEL=deepseek/deepseek-v4-flash
ROUTE_MODEL=

# 平台代理模型输入能力（影响 platform-proxy 下模型是否可接收图片）
# text       = 仅文本模型
# text,image = 多模态模型（推荐，支持图片识别）
NANOBOT_PROXY__MODEL_INPUT=text,image

# MiniMax配置
MINIMAX_API_BASE=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=sk-xxx
DEFAULT_MODEL=minimax/MiniMax-M2.7

# ── 容器时区 ─────────────────────────────────────────────────
# 用户容器（openclaw-user-*）默认时区，影响 Cron 表达式的解释
CONTAINER_TZ=Asia/Shanghai

# ── 管理员账号 ─────────────────────────────────────────────────
# 首次启动时自动创建的管理员账号（用于管理后台 http://host:3081）。
# 如果该用户名已存在，则跳过创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ── 安全配置 ─────────────────────────────────────────────────
# JWT 签名密钥，用于用户认证 token 的签发与验证。
# 生产环境务必修改为随机强密钥！可用命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-xxx

# 默认的git的skill market
NANOBOT_SKILLS_MARKETPLACE_REPO=

# 部署版本，用于openclaw-user端的容器在启动时自动升级，当版本不一致时自动升级, 升级逻辑文档doc/Upgrade.md
DEPLOY_VERSION=20260421

# ── 企业独立试点（scripts/start-enterprise.ps1） ───────────────────
# 企业启动仅使用 docker-compose.enterprise.yml，项目名 aicompany-claw。
# Gateway/前端留在 Windows；原平台 8100/18411 和现有 Docker 项目保持独立。
# 以下企业值覆盖上面的旧示例。密码/key 留空，实际 .env 由部署人员填入。
# PostgreSQL 密码 >=16 字符；管理员密码 >=12；JWT 密钥 >=32。
POSTGRES_USER=aicompany_claw
POSTGRES_PASSWORD=
POSTGRES_DB=aicompany_claw
PLATFORM_DATABASE_URL=postgresql+asyncpg://aicompany_claw:REPLACE_WITH_URL_ESCAPED_PASSWORD@127.0.0.1:15432/aicompany_claw
PLATFORM_JWT_SECRET=
PLATFORM_ADMIN_USERNAME=enterprise_admin
PLATFORM_ADMIN_PASSWORD=
# 也可留空密码值，设置以下启动脚本专用路径，由脚本读取后注入内存：
# PLATFORM_ADMIN_PASSWORD_FILE=.runtime/enterprise/admin-password.txt
PLATFORM_SHARED_OPENCLAW_ENABLED=false
PLATFORM_OPENCLAW_IMAGE=aicompany-claw:20261008
PLATFORM_CONTAINER_NETWORK=aicompany-claw-internal
PLATFORM_CONTAINER_PROXY_URL=http://host.docker.internal:8080/llm/v1
PLATFORM_CONTAINER_MCP_URL=http://host.docker.internal:8080/api/enterprise/mcp
PLATFORM_DEFAULT_MODEL=qwen3.7-flash
PLATFORM_MODEL_IDS=qwen3.7-flash,qwen3.7-plus
PLATFORM_CONTAINER_HOST_ACCESS=true
# 每人 Bridge18080由网关通过127.0.0.1动态端口访问；不公开用户浏览器/服务端口。
PLATFORM_USER_CONTAINER_PUBLISH_PORTS=false
PLATFORM_USER_CONTAINER_BIND_IP=127.0.0.1
PLATFORM_PORTAL_BASE_URL=http://127.0.0.1:8100
PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:3080
# 固定部署版本；模板/镜像升级时由部署人员共同变更。
PLATFORM_DEPLOY_VERSION=20261008
PLATFORM_CONTAINER_TZ=Asia/Shanghai
PLATFORM_CONTAINER_MEMORY_LIMIT=2g
PLATFORM_CONTAINER_CPU_LIMIT=2
PLATFORM_CONTAINER_SHM_SIZE=512m
# Windows私有Python环境默认为 .runtime/python/Scripts/python.exe。
# 首次构建：pwsh -File scripts/start-enterprise.ps1 -BuildImage -BuildOnly
# 可选企业构建下载源（版本/integrity仍由原冻结锁控制，默认为官方registry）：
# ENTERPRISE_NPM_REGISTRY=https://registry.npmmirror.com
# 启动：pwsh -File scripts/start-enterprise.ps1
# 镜像待构建时先验收业务入口：pwsh -File scripts/start-enterprise.ps1 -BusinessOnly
# 仅重启自有网关：pwsh -File scripts/stop-enterprise.ps1 -GatewayOnly，然后运行启动脚本。
# 停止：pwsh -File scripts/stop-enterprise.ps1（保留容器、卷和用户数据）。
# 首期镜像复用完整nativecore与Bridge；未安装Chromium/TeX/FFmpeg/qmd工具。
# API模型试点memorySearch禁用；仅在镜像构建副本排除linux-x64-cuda和cuda-ext。
# 原native锁文件的版本/integrity不变，保留node-llama CPU框架与其他可选依赖。
# 正式Office文档由原Windows业务Worker生成；浏览器/绘图工具需另行验收。
