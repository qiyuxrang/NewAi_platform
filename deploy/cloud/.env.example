# Copy to deploy/cloud/.env. Use independent randomly generated secrets.
APP_DOMAIN=work.example.com
ADMIN_DOMAIN=admin.example.com
PORTAL_DOMAIN=portal.example.com
TLS_EMAIL=ops@example.com
RELEASE_TAG=cloud-20261011
POSTGRES_USER=enterprise
# Use a hexadecimal password: Compose also inserts it into a database URL.
POSTGRES_PASSWORD=
PLATFORM_JWT_SECRET=
PLATFORM_ADMIN_USERNAME=enterprise_admin
PLATFORM_ADMIN_PASSWORD=
PORTAL_SECRET_KEY=
MODEL_GATEWAY_SERVICE_TOKEN=
PLATFORM_OPENCLAW_IMAGE=aicompany-claw:20261008
PLATFORM_DEFAULT_MODEL=
PLATFORM_MODEL_IDS=
# Enable after configuring and testing the real model routes in the portal.
PORTAL_PRODUCT_MODEL_CALLS_ALLOWED=0
PORTAL_PRODUCT_OCR_ENABLED=0
# RAGFlow is external. Configure per-user authorization and allowed URLs first.
PORTAL_PRODUCT_BLUEPRINT_KNOWLEDGE_MODE=ragflow_required
PORTAL_PRODUCT_KNOWLEDGE_ENABLED=0
PORTAL_PRODUCT_KNOWLEDGE_AI_CALLS_ALLOWED=0
PORTAL_PRODUCT_KNOWLEDGE_URL=
PORTAL_PRODUCT_KNOWLEDGE_ALLOWED_URLS=
PORTAL_PRODUCT_KNOWLEDGE_TOKEN_ENV=
PORTAL_PRODUCT_KNOWLEDGE_AUTHORIZATIONS=
PORTAL_PRODUCT_KNOWLEDGE_AUTHORIZATION_REVISION=
# Model provider keys use names such as PORTAL_MODEL_KEY_PRIMARY.
PORTAL_MODEL_KEY_PRIMARY=
MODEL_GATEWAY_ALLOWED_BASE_URLS=
PLATFORM_OPENAI_API_KEY=
PLATFORM_OPENAI_API_BASE=
PRODUCT_WORKER_MEMORY=4g
# Pins the deployment identity stored on user runtime containers.
PLATFORM_DEPLOY_VERSION=cloud-20261011
